#!/usr/bin/env bash
# vdrctl — the friendly front door to VDRSD (a virtual hard disk spread over
# 3 storage nodes so no single computer failure loses your files).
# No jargon needed: nodes are just called node-0, node-1, node-2.
# Usage: ./vdrctl menu   (pick numbers, plain explanations throughout)
set -uo pipefail
cd "$(dirname "$0")"

BOLD='\033[1m'; DIM='\033[2m'; RED='\033[31m'; GRN='\033[32m'; YLW='\033[33m'; BLU='\033[34m'; RST='\033[0m'
MGMT_PORTS="15052 15053 15054"

say()  { printf "${BOLD}==>${RST} %s\n" "$*"; }
ok()   { printf "${GRN}  done:${RST} %s\n" "$*"; }
warn() { printf "${YLW}  heads-up:${RST} %s\n" "$*"; }
die()  { printf "${RED}stopped:${RST} %s\n" "$*"; exit 1; }
need() { command -v "$1" >/dev/null || die "the '$1' program is missing — install it first"; }

leader() { # prints "host:port" of the node currently in charge, or nothing
  for p in $MGMT_PORTS; do
    ep=$(curl -sf --max-time 3 "http://localhost:$p/leader" 2>/dev/null | tr -d ' \r\n' || true)
    if [ -n "$ep" ] && [ "$ep" != "none" ]; then echo "$ep"; return 0; fi
  done
  return 1
}

leader_node() { # "host:port" -> node-0/1/2 (works for cluster and localhost names)
  case "$1" in
    *node-0*|*:50051) echo "node-0";;
    *node-1*|*:50052) echo "node-1";;
    *node-2*|*:50053) echo "node-2";;
    *) echo "";;
  esac
}

cmd_help() {
  printf "${BOLD}vdrctl${RST} — your replicated virtual disk, in plain words\n\n"
  printf "  ${BLU}up${RST}         start the 3 storage nodes (builds everything first)\n"
  printf "  ${BLU}status${RST}     health page: which nodes run, who is in charge, copies match?\n"
  printf "  ${BLU}test [what]${RST} prove it works: all | unit | replication | kill | quorum\n"
  printf "  ${BLU}bench${RST}      measure speed (needs the fio tool + a disk device)\n"
  printf "  ${BLU}failover${RST}   pull the plug on the leader and watch recovery happen\n"
  printf "  ${BLU}logs [node]${RST} watch what the nodes are saying (default: all)\n"
  printf "  ${BLU}down [-v]${RST}   shut everything down (-v also deletes stored files)\n"
  printf "  ${BLU}menu${RST}       step-by-step mode with explanations\n"
}

cmd_up() {
  need docker; docker compose version >/dev/null 2>&1 || die "the docker compose plugin is missing"
  say "starting the 3 storage nodes (first build takes a few minutes — only once)"
  mkdir -p vol0 vol1 vol2
  if command -v chcon >/dev/null; then chcon -Rt svirt_sandbox_file_t vol0 vol1 vol2 2>/dev/null || true; fi
  docker compose up -d --build --remove-orphans || die "could not start — see the error above"
  say "giving the nodes ~45 seconds to meet and pick a leader (staggered starts)"
  sleep 45
  ep=$(leader) || { docker compose logs --tail=20; die "no leader was picked — clues above"; }
  ok "the cluster is up; $(leader_node "$ep") is in charge ($ep)"
  cmd_status
}

cmd_status() {
  need docker; need curl
  printf "${BOLD}--- storage nodes ---${RST}  ${DIM}(want: 3 running)${RST}\n"
  docker compose ps 2>/dev/null || warn "docker is unreachable or nothing started yet"
  printf "${BOLD}--- who is in charge ---${RST}\n"
  if ep=$(leader); then
    ok "$(leader_node "$ep") is the leader ($ep) — all reads and writes go through it"
  else
    warn "no leader right now (nodes still starting, or majority is down)"
  fi
  printf "${BOLD}--- node details ---${RST}\n"
  for p in $MGMT_PORTS; do
    m=$(curl -sf --max-time 3 "localhost:$p/metrics" 2>/dev/null || true)
    [ -n "$m" ] && printf "${DIM}[check port :$p]${RST}\n$m\n"
  done
  printf "${BOLD}--- are all 3 copies identical? ---${RST}\n"
  if ls vol*/data.blk >/dev/null 2>&1; then
    sha256sum vol*/data.blk
    printf "${DIM}matching lines above = every node holds the same disk${RST}\n"
  else
    warn "no saved files yet — the cluster has never fully started"
  fi
}

cmd_test() {
  what="${1:-all}"
  case "$what" in
    unit) need cmake
      say "building the code and running its built-in self-checks"
      cmake -B build -DCMAKE_BUILD_TYPE=RelWithDebInfo >/dev/null || die "setup step failed"
      cmake --build build -j || die "compile failed — send me the first error"
      ctest --test-dir build || die "a self-check failed"
      ok "all built-in checks pass";;
    replication)
      say "check: what the leader writes, all 3 nodes store (compares the files)"
      ./tests/replication.sh && ok "every copy matches";;
    kill)
      say "check: stopping each node one by one — the rest must keep going"
      ./tests/kill_leader.sh && ok "the cluster survived every stop";;
    quorum)
      say "check: writing through the real disk device (needs a disk device + admin rights)"
      ./tests/nbd_quorum.sh && ok "disk write landed on all copies";;
    all) cmd_test unit && ./tests/replication.sh && ./tests/kill_leader.sh && ./tests/nbd_quorum.sh && ok "EVERYTHING GREEN — the project works end to end";;
    *) die "unknown check '$what' (pick: unit|replication|kill|quorum|all)";;
  esac
}

cmd_bench() { say "measuring speed (needs the fio tool + a disk device)"; ./tests/fio_bench.sh; }

cmd_failover() {
  need docker
  ep=$(leader) || die "no leader to stop (is the cluster running? try: ./vdrctl up)"
  svc=$(leader_node "$ep")
  [ -n "$svc" ] || die "could not tell which node '$ep' is"
  say "stopping the leader ($svc) — watch the rest elect a replacement"
  docker compose kill "$svc" || die "could not stop it"
  sleep 8
  ep2=$(leader) || die "no replacement appeared — something is really wrong, check: ./vdrctl logs"
  ok "replacement in charge: $ep2 — files were never at risk"
  say "bringing $svc back and confirming it catches up on its own"
  docker compose start "$svc"; sleep 8
  ./tests/replication.sh && ok "recovery complete: all 3 copies match again"
}

cmd_logs() { need docker; docker compose logs -f "${1:-}"; }

cmd_down() {
  need docker
  if [ "${1:-}" = "-v" ]; then
    say "shutting down AND deleting all stored files"
    say "(bind mounts survive 'compose down -v', so vols are removed directly)"
    docker compose down -v
    if ! rm -rf vol0 vol1 vol2 2>/dev/null; then
      warn "container-written files are root-owned; retrying with sudo"
      sudo rm -rf vol0 vol1 vol2 || die "could not clear vols — stale cluster state may persist"
    fi
    mkdir -p vol0 vol1 vol2
  else
    say "shutting down (your files in vol0-2 are kept)"; docker compose down
  fi
  ok "all stopped"
}

cmd_menu() {
  while true; do
    printf "\n${BOLD}What would you like to do?${RST}  ${DIM}(cluster: "
    leader >/dev/null 2>&1 && printf "${GRN}RUNNING${RST}${DIM}" || printf "${RED}STOPPED${RST}${DIM}"
    printf ")${RST}\n"
    printf " 1) Start the 3 storage nodes\n"
    printf " 2) Health page (who runs, who leads, copies match?)\n"
    printf " 3) Prove everything works (all checks)\n"
    printf " 4) Quick self-checks only (build + unit)\n"
    printf " 5) Pull the plug on the leader (failover demo)\n"
    printf " 6) Measure speed\n"
    printf " 7) Watch the logs\n"
    printf " 8) Shut down (keep files)   9) Shut down + delete files   0) Quit\n"
    printf "choice: "; read -r c
    case "$c" in
      1) cmd_up;; 2) cmd_status;; 3) cmd_test all;; 4) cmd_test unit;;
      5) cmd_failover;; 6) cmd_bench;; 7) cmd_logs;; 8) cmd_down;; 9) cmd_down -v;;
      0) printf "bye!\n"; exit 0;; *) warn "please pick a number 0-9";;
    esac
  done
}

case "${1:-help}" in
  up) shift; cmd_up "$@";; status) cmd_status;; test) shift; cmd_test "${1:-all}";;
  bench) cmd_bench;; failover) cmd_failover;; logs) shift; cmd_logs "${1:-}";;
  down) shift; cmd_down "${1:-}";; menu) cmd_menu;;
  help|--help|-h) cmd_help;; *) die "I don't know '$1' — try: ./vdrctl help";;
esac
