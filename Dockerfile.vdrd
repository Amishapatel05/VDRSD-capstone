# P0 multi-stage: builder + slim runtime. nuRaft deps installed but unused until VDR_WITH_NURAFT=ON (P3).
FROM ubuntu:24.04 AS builder
ARG RAFT=OFF
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git libssl-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY CMakeLists.txt ./
COPY src/ ./src/
RUN cmake -B build -DCMAKE_BUILD_TYPE=RelWithDebInfo -DVDR_WITH_NURAFT=${RAFT} || (echo '--- nuraft populate logs ---'; find build/_deps -name '*.log' -exec sh -c 'echo "== $1"; tail -25 "$1"' _ {} \; ; exit 1) && cmake --build build -j

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 iproute2 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/build/vdrd ./vdrd
COPY tools/ ./tools/
RUN chmod +x ./tools/k8s-entry.sh ./tools/connect.sh
VOLUME /data
EXPOSE 10809 50051 50052 9090
ENTRYPOINT ["./vdrd"]
